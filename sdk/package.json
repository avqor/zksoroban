{
  "name": "@zksoroban/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Soroban zero-knowledge proof formatting and verification",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test --test-force-exit test/**/*.ts",
    "test:golden": "tsx scripts/golden.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "circomlibjs": "^0.1.7",
    "ffjavascript": "^0.3.1"
  },
  "peerDependencies": {
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
